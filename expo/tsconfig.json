{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["esnext"],
    "allowJs": true
  },
  "include": [
    "packages/com/leonsilicon/zami/ports/**/*.ts",
    "packages/com/leonsilicon/zami/vite/*.ts",
    "packages/com/leonsilicon/zami/dev/*.ts",
    "packages/com/leonsilicon/zami/metro/*.js",
    "prettier.config.zam.js",
    "vite.config.ts",
    "vitest.zam.config.ts"
  ]
}
