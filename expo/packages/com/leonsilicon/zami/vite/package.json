{
  "name": "@-/com.leonsilicon.zami.vite",
  "version": "0.0.0",
  "private": true,
  "description": "Vite plugin that runs Zam's code from its .expo. versions (used to run upstream's tests against Zami's files).",
  "type": "module",
  "imports": {
    "#*": "./*.ts"
  },
  "exports": {
    ".": "./+.ts",
    "./zam-test-setup": "./+zam-test-setup.ts"
  },
  "dependencies": {
    "@-/com.leonsilicon.zami.ports": "workspace:*",
    "esbuild": "catalog:",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
