{
  "name": "@-/com.leonsilicon.zami.plugins",
  "version": "0.0.0",
  "private": true,
  "description": "`zam.zami`, what the Zami app adds to Zam's plugin API (every module of the app, function and component patches, stores, early loading, the native side), and the Vite plugin that builds it into Zam's web app.",
  "type": "module",
  "imports": {
    "#dom-host": "./dom-host.svelte",
    "#around": "./around.svelte",
    "#launch-splash": "./launch-splash.svelte",
    "#runes.svelte": "./runes.svelte.ts",
    "#safety.svelte": "./safety.svelte.ts",
    "#paper-css": "./paper.css",
    "#*": "./*.ts"
  },
  "exports": {
    ".": "./+.ts",
    "./web": "./+web.ts"
  },
  "devDependencies": {
    "@-/com.leonsilicon.zami.paths": "workspace:*",
    "@types/node": "catalog:",
    "acorn": "catalog:",
    "svelte": "catalog:",
    "vite-plus": "catalog:"
  }
}
