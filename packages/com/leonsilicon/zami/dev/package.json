{
  "name": "@-/com.leonsilicon.zami.dev",
  "version": "0.0.0",
  "private": true,
  "description": "`vpx _dev`: build, install and run the Zami app with its dev server; `vpx _testflight`: upload it to TestFlight.",
  "bin": {
    "_dev": "./_dev.ts",
    "_testflight": "./_testflight.ts"
  },
  "type": "module",
  "imports": {
    "#*": "./*.ts"
  },
  "exports": {
    ".": "./+.ts"
  },
  "dependencies": {
    "@-/com.leonsilicon.zami.ports": "workspace:*",
    "expo": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
