      "**/.git": true,
      "**/.hg": true,
      "**/.svn": true,
      "**/CVS": true,
      "**/Thumbs.db": true,
      "*/**/*.bin": {
        "when": "$(basename).zami.bin"
      },
      "*/**/*.cc": {
        "when": "$(basename).zami.cc"
      },
      "*/**/*.css": {
        "when": "$(basename).zami.css"
