      "*/**/*.wasm": {
        "when": "$(basename).zami.wasm"
      },
      "*/**/*.webmanifest": {
        "when": "$(basename).zami.webmanifest"
      },
      "*/**/*.woff2": {
        "when": "$(basename).zami.woff2"
      },
      "*/**/LICENSE_APACHE": {
        "when": "$(basename).zami"
      },
      "*/**/LICENSE_MIT": {
        "when": "$(basename).zami"
