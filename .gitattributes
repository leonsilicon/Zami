# Zami replaces Zam's root package.json with its own workspace manifest (Bun reads no other
# name; Zam's version keeps syncing as package.zami.json), so merging upstream keeps Zami's.
# The `ours` driver is registered per clone by the workspace postinstall
# (`git config merge.ours.driver true`).
package.json merge=ours

# Generated by `vpx _zami editor`: collapse them in diffs.
.zed/settings.json linguist-generated=true
zami.code-workspace linguist-generated=true
