{
  "name": "zami-development",
  "version": "0.0.0",
  "private": true,
  "description": "Zami: upstream Zam's web app in an Expo app, with what Zami adds to it.",
  "license": "GPL-3.0-or-later",
  "author": "Leon Si",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonsilicon/Zami.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/com/leonsilicon/**"
    ],
    "catalog": {
      "@capacitor/core": "8.5.2",
      "@codemod.com/jssg-types": "1.6.3",
      "@types/node": "24.19.2",
      "@types/react": "19.3.0",
      "acorn": "8.19.0",
      "codemod": "1.18.6",
      "eslint-plugin-flatcap": "0.1.0",
      "expo": "58.0.23",
      "expo-application": "58.1.2",
      "expo-constants": "58.0.15",
      "expo-device": "58.0.5",
      "expo-modules-core": "58.0.30",
      "expo-notifications": "58.1.8",
      "expo-sqlite": "58.0.15",
      "expo-status-bar": "58.0.4",
      "expo-web-browser": "58.0.7",
      "react": "19.3.0",
      "react-native": "0.88.1",
      "react-native-safe-area-context": "5.11.1",
      "react-native-webview": "14.0.1",
      "svelte": "5.57.1",
      "typescript": "7.0.2",
      "vite-plus": "1.5.0"
    }
  },
  "type": "module",
  "devDependencies": {
    "@-/com.leonsilicon.zami.configs.patches": "workspace:*",
    "@-/com.leonsilicon.zami.dev": "workspace:*",
    "@-/com.leonsilicon.zami.web": "workspace:*",
    "@types/node": "catalog:",
    "eslint-plugin-flatcap": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "react-native-webview@14.0.1": "patches/react-native-webview@14.0.1.patch"
  }
}
