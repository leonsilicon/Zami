// zami-push.leonsilicon.com: Zami's Matrix push gateway (@-/com.leonsilicon.zami.push-gateway)
// on Cloudflare Workers. The custom domain makes Cloudflare create the DNS record and the
// certificate. Homeservers post to https://zami-push.leonsilicon.com/_matrix/push/v1/notify.
{
  "name": "zami-push-gateway",
  "main": "worker.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // The pushers' app ids it serves: the production and staging apps' bundle ids.
    "APP_IDS": "com.leonsilicon.zami,com.leonsilicon.zami.staging",
  },
  // EXPO_ACCESS_TOKEN (optional) is a secret: `vpx wrangler secret put EXPO_ACCESS_TOKEN`.
  "routes": [{ "pattern": "zami-push.leonsilicon.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
