{
  "expo": {
    "name": "Zami",
    "slug": "zami",
    "icon": "./assets/icon.png",
    "owner": "improvelabs",
    "scheme": ["zami", "com.leonsilicon.zami"],
    "version": "1.20261123.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f3ede0",
    "ios": {
      "bundleIdentifier": "com.leonsilicon.zami",
      "supportsTablet": true,
      "appleTeamId": "M76P5G9HXK",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Zami uses the camera for video calls, sign-in QR codes and photos you send.",
        "NSMicrophoneUsageDescription": "Zami uses the microphone for voice messages and calls.",
        "NSLocationWhenInUseUsageDescription": "Zami shares your location only when you choose to send it.",
        "NSPhotoLibraryAddUsageDescription": "Zami saves the images and videos you choose to your photo library.",
        "UIBackgroundModes": ["audio", "remote-notification"]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDataTypes",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.leonsilicon.zami",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": ["expo-sqlite", "expo-notifications", "expo-web-browser"],
    "extra": {
      "eas": {
        "projectId": "0e15223a-ea96-4bfc-9411-7879f30a8e35"
      }
    }
  }
}
