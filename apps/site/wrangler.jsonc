// zami.leonsilicon.com: the static files in public/, on Cloudflare Workers. The custom
// domain makes Cloudflare create the DNS record and the certificate.
{
  "name": "zami-site",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "zami.leonsilicon.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
