+                break;
+        }
+        if (i < batch.length) {
+            // Nothing joined the queue meanwhile (new tasks wait in microtasks), but keep order anyway.
+            deferred = batch.slice(i).concat(deferred);
+            queueTurn();
+        }
+    }
+    return {
+        stats,
+        get budgetMs() {
+            return budget;
+        },
+        set budgetMs(ms) {
+            budget = ms;
+        },
+        queueTask(fn) {
+            const task = { run: fn, seq: nextSeq++, hops };
+            if (deferred.length > 0) {
+                defer(task);
+                return;
+            }
+            task.step = () => step(task);
+            microtask(task.step);
+        },
+    };
+}
